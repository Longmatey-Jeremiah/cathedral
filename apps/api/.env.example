NODE_ENV=development
PORT=4000

# Local Postgres uses one URL. A pooled provider (Neon/Supabase) needs two:
# DATABASE_URL = pooled (pgbouncer) for the app, DIRECT_URL = direct for migrations.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/church_db?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/church_db?schema=public

JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=1h
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=2d
# Optional: distinct secret for refresh tokens (falls back to JWT_SECRET)
JWT_REFRESH_SECRET=replace-me-with-another-long-random-string

INVITE_TOKEN_TTL_HOURS=72
APP_URL=http://localhost:3000

# Brevo (free: 300 emails/day). Key from https://app.brevo.com/settings/keys/api
# Leave empty to log emails instead of sending them.
# MAIL_FROM must be a sender you verified in Brevo.
BREVO_API_KEY=
MAIL_FROM="Church Platform <noreply@church.app>"

# Bootstrap super admin (used by `npm run prisma:seed`)
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=change-me-please-min-12-chars
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin

# Google sign-in (free). Create an OAuth client at
# https://console.cloud.google.com/apis/credentials → "Web application", and add
# GOOGLE_CALLBACK_URL below as an Authorized redirect URI. Only openid/email/
# profile scopes are used, so no Google verification review is required.
# Leave GOOGLE_CLIENT_ID empty to disable the Google routes entirely.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Claude. Key from https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5
