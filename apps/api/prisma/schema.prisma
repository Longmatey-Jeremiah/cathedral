generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (pgbouncer) — app runtime
  directUrl = env("DIRECT_URL") // direct — migrations & introspection
}

enum UserStatus {
  ACTIVE
  PENDING
}

enum NotificationChannel {
  EMAIL
  SMS
  BOTH
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  FINANCE
  DEPARTMENT_LEADER
  MEMBER_CARE
  VIEWER
}

enum CareType {
  VISIT
  CALL
  PRAYER
  COUNSEL
  FOLLOW_UP
}

enum GivingMethod {
  CASH
  TRANSFER
  CARD
  MOBILE_MONEY
}

enum AttendanceStatus {
  DRAFT // being recorded, editable
  SUBMITTED // handed off for review
  REVIEWED // signed off, locked
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  VISITOR
}

enum DepartmentRole {
  MEMBER
  LEADER
}

enum Sex {
  MALE
  FEMALE
}

enum MaritalStatus {
  SINGLE
  MARRIED
  WIDOWED
  DIVORCED
}

model Church {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  address         String?
  phone           String?
  email           String?
  isActive        Boolean  @default(true)
  // ISO 4217. Seeds the currency on new donations; existing rows keep theirs.
  defaultCurrency String   @default("NGN")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users        User[]
  invites      UserInvite[]
  departments  Department[]
  members      Member[]
  sessions     AttendanceSession[]
  serviceTypes ServiceType[]
  careNotes    CareNote[]
  funds        Fund[]
  donations    Donation[]

  @@index([slug])
}

model Department {
  id          String   @id @default(uuid())
  name        String
  description String?
  churchId    String
  church      Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members MemberDepartment[]

  @@unique([churchId, name])
  @@index([churchId])
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  password           String?
  firstName          String?
  lastName           String?
  role               UserRole
  status             UserStatus          @default(PENDING)
  mustChangePassword Boolean             @default(false)
  // Notification delivery. SMS/BOTH need a phone on file — the sender falls
  // back to email if one is missing rather than dropping the notification.
  phone              String?
  notifyVia          NotificationChannel @default(EMAIL)
  churchId           String?
  church             Church?             @relation(fields: [churchId], references: [id], onDelete: Cascade)
  member             Member?
  recordedSessions   AttendanceSession[] @relation("SessionRecorder")
  reviewedSessions   AttendanceSession[] @relation("SessionReviewer")
  loginSessions      Session[]
  careNotes          CareNote[]          @relation("CareAuthor")
  recordedDonations  Donation[]          @relation("DonationRecorder")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([email])
  @@index([churchId])
}

model UserInvite {
  id        String   @id @default(uuid())
  email     String
  role      UserRole
  tokenHash String
  // Raw token kept so an admin can re-view/copy the invite link later. Deliberate
  // trade-off: a DB leak exposes usable links until they expire or are used.
  token     String?
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  churchId  String?
  church    Church?  @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([tokenHash])
  @@index([churchId])
}

// A login session — one per device/refresh-token lineage. Created on login,
// touched on refresh, revoked on sign-out. Backs the "active sessions" list.
model Session {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String // sha256 of the current refresh token — rotated each refresh
  userAgent        String?
  ip               String?
  createdAt        DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())
  revokedAt        DateTime? // null = active

  @@index([userId])
}

// Church/domain entity — distinct from User (auth). A member MAY link to a
// user account (userId) but visitors/guests have none.
model Member {
  id        String       @id @default(uuid())
  userId    String?      @unique
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  churchId  String
  church    Church       @relation(fields: [churchId], references: [id], onDelete: Cascade)
  // The membership form's "Other Names" and "Surname". Kept under the original
  // column names — display, search and sorting across the app read these.
  firstName String
  lastName  String
  phone     String? // Tel. No.
  avatarUrl String?
  status    MemberStatus @default(VISITOR)
  joinDate  DateTime     @default(now())

  // Membership registration form. All optional: the quick-add flow captures a
  // name and a phone, and the form is filled in later.
  sex                   Sex?
  dateOfBirth           DateTime?
  placeOfBirth          String?
  address               String?
  placeOfResidence      String?
  occupation            String?
  placeOfWork           String?
  society               String?
  nextOfKin             String?
  parentsName           String?
  hometown              String?
  maritalStatus         MaritalStatus?
  spouseName            String?
  spouseOccupation      String?
  religiousDenomination String?
  childrenNames         String[] // one name per entry; empty for none
  declarationDate       DateTime?

  deletedAt DateTime? // soft delete preserves historical records
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  departments MemberDepartment[]
  attendance  Attendance[]
  careNotes   CareNote[]
  donations   Donation[]

  @@index([userId])
  @@index([status])
  @@index([churchId, status]) // tenant + status filter, the common list query
}

// Many-to-many join: a member belongs to multiple departments, each with a role.
model MemberDepartment {
  memberId     String
  departmentId String
  role         DepartmentRole @default(MEMBER)
  member       Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  department   Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([memberId, departmentId]) // composite primary key
  @@index([memberId])
  @@index([departmentId])
}

// A recurring kind of gathering — Sunday Service, Bible Study, Vigil. Church-
// scoped lookup, same shape as Fund.
model ServiceType {
  id        String   @id @default(uuid())
  churchId  String
  church    Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions AttendanceSession[]

  @@unique([churchId, name])
  @@index([churchId, isActive])
}

// A church gathering (service, meeting, event) on a given date. Attendance is
// recorded against a session.
model AttendanceSession {
  id       String           @id @default(uuid())
  churchId String
  church   Church           @relation(fields: [churchId], references: [id], onDelete: Cascade)
  title    String
  date     DateTime
  status   AttendanceStatus @default(DRAFT)

  // Optional: sessions predating service types (and one-off gatherings) have none.
  // Restrict, not cascade — retiring a type must never delete attendance history.
  serviceTypeId String?
  serviceType   ServiceType? @relation(fields: [serviceTypeId], references: [id], onDelete: Restrict)

  recordedById String
  recordedBy   User      @relation("SessionRecorder", fields: [recordedById], references: [id])
  reviewedById String?
  reviewedBy   User?     @relation("SessionReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  records Attendance[]

  @@index([churchId, date]) // tenant + date-ordered listing, the common query
}

// A present-mark: the row existing means the member attended the session.
// No present/absent flag — absence is simply the absence of a row.
model Attendance {
  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  markedAt  DateTime          @default(now())

  @@id([sessionId, memberId]) // composite primary key
  @@index([sessionId])
  @@index([memberId])
}

// Pastoral care log — visits, calls, prayer requests, counselling, follow-ups.
// One table + a `type` enum; split only if the fields genuinely diverge.
model CareNote {
  id           String    @id @default(uuid())
  churchId     String
  church       Church    @relation(fields: [churchId], references: [id], onDelete: Cascade)
  memberId     String
  member       Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  authorId     String
  author       User      @relation("CareAuthor", fields: [authorId], references: [id])
  type         CareType
  body         String
  // Counselling notes: readable only by ADMIN and the author. Enforced in the
  // repository so no controller can forget it.
  confidential Boolean   @default(false)
  followUpAt   DateTime? // set = someone owes this member a call back
  resolvedAt   DateTime? // null + past followUpAt = overdue
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([churchId, memberId])
  @@index([churchId, followUpAt]) // the overdue-follow-ups queue
}

// A giving designation (Tithe, Building, Missions). Church-scoped.
model Fund {
  id        String   @id @default(uuid())
  churchId  String
  church    Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  donations Donation[]

  @@unique([churchId, name])
  @@index([churchId, isActive])
}

// Append-only giving ledger. Rows are never updated or deleted — a correction
// is a new row with `reversesId` pointing at the original and a negated amount.
model Donation {
  id           String       @id @default(uuid())
  churchId     String
  church       Church       @relation(fields: [churchId], references: [id], onDelete: Cascade)
  memberId     String? // null = anonymous giving, which is normal
  member       Member?      @relation(fields: [memberId], references: [id], onDelete: SetNull)
  fundId       String
  fund         Fund         @relation(fields: [fundId], references: [id])
  // Minor units (kobo/cents). Never a float — binary floats cannot represent money.
  amountMinor  Int
  currency     String       @default("NGN")
  method       GivingMethod
  reference    String? // cheque no., teller no., operator reference
  note         String?
  // Payment-provider id. Unique => a replayed webhook is a no-op at the DB level,
  // no dedup logic in the service.
  providerRef  String?      @unique
  reversesId   String?      @unique // a reversal points at exactly one original
  reverses     Donation?    @relation("DonationReversal", fields: [reversesId], references: [id])
  reversedBy   Donation?    @relation("DonationReversal")
  recordedById String
  recordedBy   User         @relation("DonationRecorder", fields: [recordedById], references: [id])
  givenAt      DateTime
  createdAt    DateTime     @default(now())

  @@index([churchId, givenAt])
  @@index([churchId, fundId])
  @@index([memberId])
}
