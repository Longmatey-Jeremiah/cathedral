generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  PENDING
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  FINANCE
  DEPARTMENT_LEADER
  VIEWER
}

enum AttendanceStatus {
  DRAFT // being recorded, editable
  SUBMITTED // handed off for review
  REVIEWED // signed off, locked
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  VISITOR
}

enum DepartmentRole {
  MEMBER
  LEADER
}

model Church {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  address   String?
  phone     String?
  email     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  invites     UserInvite[]
  departments Department[]
  members     Member[]
  sessions    AttendanceSession[]

  @@index([slug])
}

model Department {
  id          String   @id @default(uuid())
  name        String
  description String?
  churchId    String
  church      Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members MemberDepartment[]

  @@unique([churchId, name])
  @@index([churchId])
}

model User {
  id                 String     @id @default(uuid())
  email              String     @unique
  password           String?
  firstName          String?
  lastName           String?
  role               UserRole
  status             UserStatus @default(PENDING)
  mustChangePassword Boolean    @default(false)
  churchId           String?
  church             Church?    @relation(fields: [churchId], references: [id], onDelete: Cascade)
  member             Member?
  recordedSessions   AttendanceSession[] @relation("SessionRecorder")
  reviewedSessions   AttendanceSession[] @relation("SessionReviewer")
  loginSessions      Session[]
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([email])
  @@index([churchId])
}

model UserInvite {
  id        String   @id @default(uuid())
  email     String
  role      UserRole
  tokenHash String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  churchId  String?
  church    Church?  @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([tokenHash])
  @@index([churchId])
}

// A login session — one per device/refresh-token lineage. Created on login,
// touched on refresh, revoked on sign-out. Backs the "active sessions" list.
model Session {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String // sha256 of the current refresh token — rotated each refresh
  userAgent        String?
  ip               String?
  createdAt        DateTime @default(now())
  lastSeenAt       DateTime @default(now())
  revokedAt        DateTime? // null = active

  @@index([userId])
}

// Church/domain entity — distinct from User (auth). A member MAY link to a
// user account (userId) but visitors/guests have none.
model Member {
  id        String       @id @default(uuid())
  userId    String?      @unique
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  churchId  String
  church    Church       @relation(fields: [churchId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  phone     String?
  avatarUrl String?
  status    MemberStatus @default(VISITOR)
  joinDate  DateTime     @default(now())
  deletedAt DateTime? // soft delete preserves historical records
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  departments MemberDepartment[]
  attendance  Attendance[]

  @@index([userId])
  @@index([status])
  @@index([churchId, status]) // tenant + status filter, the common list query
}

// Many-to-many join: a member belongs to multiple departments, each with a role.
model MemberDepartment {
  memberId     String
  departmentId String
  role         DepartmentRole @default(MEMBER)
  member       Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  department   Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([memberId, departmentId]) // composite primary key
  @@index([memberId])
  @@index([departmentId])
}

// A church gathering (service, meeting, event) on a given date. Attendance is
// recorded against a session.
model AttendanceSession {
  id        String   @id @default(uuid())
  churchId  String
  church    Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  title     String
  date      DateTime
  status    AttendanceStatus @default(DRAFT)

  recordedById String
  recordedBy   User   @relation("SessionRecorder", fields: [recordedById], references: [id])
  reviewedById String?
  reviewedBy   User?  @relation("SessionReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  records Attendance[]

  @@index([churchId, date]) // tenant + date-ordered listing, the common query
}

// A present-mark: the row existing means the member attended the session.
// No present/absent flag — absence is simply the absence of a row.
model Attendance {
  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  markedAt  DateTime          @default(now())

  @@id([sessionId, memberId]) // composite primary key
  @@index([sessionId])
  @@index([memberId])
}
